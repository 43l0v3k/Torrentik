<Window x:Class="Torrentik.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Torrentik" Width="980" Height="560" MinWidth="720" MinHeight="360"
        Background="#1B1B1F" Foreground="#E6E6EA" AllowDrop="True"
        Drop="Window_Drop">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Background" Value="#2A2A32"/>
            <Setter Property="Foreground" Value="#E6E6EA"/>
            <Setter Property="BorderBrush" Value="#3A3A44"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2A2A32"/>
            <Setter Property="Foreground" Value="#E6E6EA"/>
            <Setter Property="BorderBrush" Value="#3A3A44"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="＋ .torrent" Click="AddFile_Click"/>
            <Button Content="＋ Magnet" Click="AddMagnet_Click"/>
            <Button Content="▶ Старт" Click="Start_Click"/>
            <Button Content="⏸ Пауза" Click="Pause_Click"/>
            <Button Content="✕ Удалить" Click="Remove_Click"/>
            <Button Content="📁 Открыть папку" Click="OpenFolder_Click"/>
            <Button Content="⚙ Настройки" Click="Settings_Click"/>
        </StackPanel>

        <DataGrid x:Name="Grid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Extended" HeadersVisibility="Column" GridLinesVisibility="None"
                  Background="#202026" RowBackground="#202026" AlternatingRowBackground="#25252C"
                  Foreground="#E6E6EA" BorderBrush="#3A3A44" CanUserAddRows="False">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#2A2A32"/>
                    <Setter Property="Foreground" Value="#E6E6EA"/>
                    <Setter Property="Padding" Value="8,6"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Размер" Binding="{Binding Size}" Width="90"/>
                <DataGridTemplateColumn Header="Прогресс" Width="150">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid Margin="4,3">
                                <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}"
                                             Height="18" Foreground="#2962FF" Background="#33333D" BorderThickness="0"/>
                                <TextBlock Text="{Binding ProgressText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="White" FontSize="11"/>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="110"/>
                <DataGridTextColumn Header="↓" Binding="{Binding DownSpeed}" Width="90"/>
                <DataGridTextColumn Header="↑" Binding="{Binding UpSpeed}" Width="90"/>
                <DataGridTextColumn Header="Пиры" Binding="{Binding Peers}" Width="60"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock x:Name="StatusBar" Grid.Row="2" Margin="0,10,0,0" Foreground="#9A9AA5"
                   Text="Перетащи .torrent сюда или вставь magnet-ссылку"/>
    </Grid>
</Window>
